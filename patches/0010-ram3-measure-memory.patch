+// Memory for measure cache data. Every measurement structure below is an
+// alternative view of this buffer; the largest is s21_filter_measure_t at
+// 76 bytes on Cortex-M0. The buffer is 4-byte aligned because those views
+// contain float/int32_t members, and Cortex-M0 faults on unaligned access.
+#define MEASURE_MEMORY_SIZE 80
+static char measure_memory[MEASURE_MEMORY_SIZE] __attribute__((aligned(4)));
 
