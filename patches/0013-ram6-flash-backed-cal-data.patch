+/*
+ * RAM-6: per-point reconstruction of the error terms.
+ *
+ * `src` points at the first array of the live flash record, so src[t][0..1] is
+ * the value of error term `t` at `point`. `out` receives the new record. This
+ * mirrors cal_done()'s sequence of set/copy/calc steps, evaluated for a single
+ * point so nothing has to be staged in RAM.
+ */
+static void cal_done_point(int point, float out[CAL_TYPE_COUNT][2], const float *src)
+{
+  const int has_load  = current_props._cal_status & CALSTAT_LOAD;
+  const int has_open  = current_props._cal_status & CALSTAT_OPEN;
+  const int has_short = current_props._cal_status & CALSTAT_SHORT;
+  const int has_thru  = current_props._cal_status & CALSTAT_THRU;
+  const int has_isoln = current_props._cal_status & CALSTAT_ISOLN;
+
+  // Points beyond the calibration sweep keep their previous values; upstream
+  // only rewrites 0..sweep_points-1 and leaves the tail untouched.
+  if (point >= (int)current_props._cal_sweep_points) {
+    int t;
+    for (t = 0; t < CAL_TYPE_COUNT; t++) {
+      out[t][0] = src[t * SWEEP_POINTS_MAX * 2 + point * 2 + 0];
+      out[t][1] = src[t * SWEEP_POINTS_MAX * 2 + point * 2 + 1];
+    }
+    return;
+  }
+
+  // Inputs, indexed by error-term/cal-type number.
+  float ed_r = has_load  ? src[ETERM_ED * SWEEP_POINTS_MAX * 2 + point * 2 + 0] : 0.0f;
+  float ed_i = has_load  ? src[ETERM_ED * SWEEP_POINTS_MAX * 2 + point * 2 + 1] : 0.0f;
+  float op_r = src[CAL_OPEN  * SWEEP_POINTS_MAX * 2 + point * 2 + 0];
+  float op_i = src[CAL_OPEN  * SWEEP_POINTS_MAX * 2 + point * 2 + 1];
+  float sh_r = src[CAL_SHORT * SWEEP_POINTS_MAX * 2 + point * 2 + 0];
+  float sh_i = src[CAL_SHORT * SWEEP_POINTS_MAX * 2 + point * 2 + 1];
+  float th_r = src[CAL_THRU  * SWEEP_POINTS_MAX * 2 + point * 2 + 0];
+  float th_i = src[CAL_THRU  * SWEEP_POINTS_MAX * 2 + point * 2 + 1];
+  float is_r = has_isoln ? src[CAL_ISOLN * SWEEP_POINTS_MAX * 2 + point * 2 + 0] : 0.0f;
+  float is_i = has_isoln ? src[CAL_ISOLN * SWEEP_POINTS_MAX * 2 + point * 2 + 1] : 0.0f;
+
+  float es_r = 0.0f, es_i = 0.0f, er_r = 1.0f, er_i = 0.0f;
+  float et_r = 1.0f, et_i = 0.0f;
+
+  if (has_short && has_open) {
+    // Es = (S11mo' + S11ms') / (S11mo' - S11ms'), with S11a=1.
+    float s11or = op_r - ed_r, s11oi = op_i - ed_i;
+    float s11sr = sh_r - ed_r, s11si = sh_i - ed_i;
+    float denomr = s11or - s11sr;
+    float denomi = s11oi - s11si;
+    float d = denomr * denomr + denomi * denomi;
+    float numr = s11sr + s11or;
+    float numi = s11si + s11oi;
+    es_r = (numr * denomr + numi * denomi) / d;
+    es_i = (numi * denomr - numr * denomi) / d;
+    // Er = (1 + Es) S11ms'
+    {
+      float k_r = 1.0f + es_r, k_i = es_i;
+      er_r = -(k_r * s11sr - k_i * s11si);
+      er_i = -(k_r * s11si + k_i * s11sr);
+    }
+  } else if (has_open) {
+    // Short not measured: assume S11ms' = S11mo' (eterm_copy(CAL_SHORT, CAL_OPEN)).
+    float s11sr = op_r - ed_r, s11si = op_i - ed_i;
+    float k_r = 1.0f, k_i = 0.0f;   // Es = 0
+    er_r = k_r * s11sr - k_i * s11si;
+    er_i = k_r * s11si + k_i * s11sr;
+    es_r = es_i = 0.0f;
+  } else if (has_short) {
+    // Open not measured: Es = 0, then eterm_calc_er(-1) negates the result.
+    er_r = -(sh_r - ed_r);
+    er_i = -(sh_i - ed_i);
+    es_r = es_i = 0.0f;
+  } else {
+    es_r = es_i = 0.0f;
+    er_r = 1.0f;
+    er_i = 0.0f;
+  }
+
+  if (has_thru) {
+    // Et is stored inverted for efficiency: Et = 1 / (S21mt - Ex).
+    float etr = th_r - is_r;
+    float eti = th_i - is_i;
+    float sq = etr * etr + eti * eti;
+    et_r =  etr / sq;
+    et_i = -eti / sq;
+  }
+
+  out[ETERM_ED][0] = ed_r;
+  out[ETERM_ED][1] = ed_i;
+  out[ETERM_ES][0] = es_r;
+  out[ETERM_ES][1] = es_i;
+  out[ETERM_ER][0] = er_r;
+  out[ETERM_ER][1] = er_i;
+  out[ETERM_ET][0] = et_r;
+  out[ETERM_ET][1] = et_i;
+  out[ETERM_EX][0] = is_r;
+  out[ETERM_EX][1] = is_i;
+}
 
