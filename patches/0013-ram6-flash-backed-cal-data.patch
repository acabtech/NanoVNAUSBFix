+/*
+ * RAM-6 calibration-session API, used by main.c.
+ *
+ * Both calls leave the result in the working slot and point `cal_data` at it.
+ */
+int cal_store_array(int type, const void *array)
+{
+  if (type < 0 || type >= CAL_TYPE_COUNT)
+    return -1;
+  current_props.magic = PROPERTIES_MAGIC;
+  if (cal_record_write(cal_free_slot, cal_active_slot, type,
+                       (const float *)array) < 0)
+    return -1;
+  // Swap: the freshly written record becomes the live one.
+  {
+    int tmp = cal_active_slot;
+    cal_active_slot = cal_free_slot;
+    cal_free_slot = tmp;
+  }
+  cal_use_slot(cal_active_slot);
+  checksum_ok &= ~(1 << cal_active_slot);
+  return 0;
+}
+
+int cal_write_live_record(void)
+{
+  current_props.magic = PROPERTIES_MAGIC;
+  if (cal_record_write(cal_free_slot, cal_active_slot, -1, NULL) < 0)
+    return -1;
+  {
+    int tmp = cal_active_slot;
+    cal_active_slot = cal_free_slot;
+    cal_free_slot = tmp;
+  }
+  cal_use_slot(cal_active_slot);
+  checksum_ok &= ~(1 << cal_active_slot);
+  return 0;
+}
+
+int cal_active_slot_index(void) { return cal_active_slot; }
+
+/*
+ * RAM-6: build the live record from an external record image (SD `.cal` load).
+ *
+ * `read(buf, len)` must return 0 on success. The header is taken from
+ * `current_props`; only the calibration arrays are read from the source. Data
+ * is streamed through a small stack buffer so no 4 KB staging is required.
+ */
+int cal_record_read_arrays(int (*read_fn)(void *buf, uint32_t len))
+{
+  // Static 64-byte chunk: the sweep thread has only ~136 B of stack margin, so
+  // a 256-byte local frame would overflow it.
+  static uint16_t chunk[32];
+  const uint32_t dst = calibration_slot_area(cal_free_slot);
+  const uint32_t chunk_size = sizeof(chunk);
+  uint32_t remaining = PROPS_CAL_SIZE;
+
+  current_props.magic = PROPERTIES_MAGIC;
+  flash_erase_pages(dst, PROPS_RECORD_SIZE);
+  if (flash_program_noerase(dst, &current_props, PROPS_HEADER_SIZE) < 0)
+    return -1;
+
+  while (remaining > 0) {
+    uint32_t n = remaining < chunk_size ? remaining : chunk_size;
+    uint32_t off = PROPS_CAL_OFFSET + (PROPS_CAL_SIZE - remaining);
+    if (read_fn(chunk, n) != 0)
+      return -1;
+    if (flash_program_noerase(dst + off, chunk, n) < 0)
+      return -1;
+    remaining -= n;
+  }
+
+  {
+    uint32_t sum = checksum((const void *)dst, PROPS_RECORD_SIZE - sizeof(uint32_t));
+    if (flash_program_noerase(dst + PROPS_CHECKSUM_OFFSET, &sum, sizeof(sum)) < 0)
+      return -1;
+  }
+
+  // Commit: the freshly written record becomes live.
+  {
+    int tmp = cal_active_slot;
+    cal_active_slot = cal_free_slot;
+    cal_free_slot = tmp;
+  }
+  cal_use_slot(cal_active_slot);
+  checksum_ok &= ~(1 << cal_active_slot);
+  return 0;
+}
+
+// Fill one point with zeros; used to reset the record when no calibration
+// exists so `cal_data` never exposes erased-flash values.
+static void cal_zero_point(int point, float out[CAL_TYPE_COUNT][2], const float *src)
+{
+  int t;
+  (void)point;
+  (void)src;
+  for (t = 0; t < CAL_TYPE_COUNT; t++)
+    out[t][0] = out[t][1] = 0.0f;
+}
+
+/*
+ * Replace the live record's arrays with all zeros.
+ */
+int cal_clear_record(void)
+{
+  return cal_transform_record(cal_zero_point);
+}
+
+int cal_transform_record(cal_point_cb cb)
