+// Program `size` bytes into an already-erased destination. Returns 0 on
+// success, -1 if a destination half-word was not blank.
+static int flash_program_noerase(uint32_t dst, const void *data, uint32_t size)
+{
+  const uint16_t *src = (const uint16_t *)data;
+  uint32_t i;
+  for (i = 0; i < size / sizeof(uint16_t); i++)
+    if (flash_program_half_word_noerase((uint16_t *)(dst + i * 2), src[i]) < 0)
+      return -1;
+  return 0;
+}
+
+/*
+ * Point-wise record transform.
+ *
+ * `cb(point, out, src)` fills `out` with the five error-term values for one
+ * sweep point, reading the same point from `src` (the source slot's arrays).
+ * The record header in `current_props` is written unchanged.
+ *
+ * Writing one point at a time keeps the RAM cost at 40 bytes regardless of
+ * SWEEP_POINTS_MAX, which is what allows `cal_done()` to derive ES/ER/ET
+ * without a second 4 KB array.
+ */
+static int cal_record_transform(int dst_slot, int src_slot, cal_point_cb cb)
+{
+  const uint32_t dst = calibration_slot_area(dst_slot);
+  const uint32_t src = calibration_slot_area(src_slot);
+  const uint32_t type_size = PROPS_CAL_SIZE / CAL_TYPE_COUNT;
+  const uint32_t point_size = type_size / SWEEP_POINTS_MAX;
+  int i, t;
+
+  flash_erase_pages(dst, PROPS_RECORD_SIZE);
+  if (flash_program_noerase(dst, &current_props, PROPS_HEADER_SIZE) < 0)
+    return -1;
+
+  for (i = 0; i < SWEEP_POINTS_MAX; i++) {
+    float out[CAL_TYPE_COUNT][2];
+    cb(i, out, (const float *)(src + PROPS_CAL_OFFSET));
+    for (t = 0; t < CAL_TYPE_COUNT; t++) {
+      const uint32_t off = dst + PROPS_CAL_OFFSET +
+                           (uint32_t)t * type_size + (uint32_t)i * point_size;
+      if (flash_program_noerase(off, out[t], sizeof(out[t])) < 0)
+        return -1;
+    }
+  }
+
+  {
+    uint32_t sum = checksum((const void *)dst, PROPS_RECORD_SIZE - sizeof(uint32_t));
+    if (flash_program_noerase(dst + PROPS_CHECKSUM_OFFSET, &sum, sizeof(sum)) < 0)
+      return -1;
+  }
+  return 0;
+}
+
+/*
+ * Build a complete calibration record in `dst_slot` from the header in
+ * `current_props` and the arrays of `src_slot`. When `patch_type` is a valid
+ * calibration index, that one array is taken from `patch` instead of the
+ * source slot; all other arrays are copied from `src_slot`.
+ *
+ * The source slot is only ever read, so this can run while the destination
+ * pages are being erased and programmed. No RAM staging buffer is needed.
+ */
+static int cal_record_write(int dst_slot, int src_slot, int patch_type, const float *patch)
+{
+  const uint32_t dst = calibration_slot_area(dst_slot);
+  const uint32_t src = calibration_slot_area(src_slot);
+  const uint32_t type_size = PROPS_CAL_SIZE / CAL_TYPE_COUNT;
+  int t;
+
+  // Erase the destination pages, then program the header.
+  flash_erase_pages(dst, PROPS_RECORD_SIZE);
+  if (flash_program_noerase(dst, &current_props, PROPS_HEADER_SIZE) < 0)
+    return -1;
+
+  // Program the five calibration arrays.
+  for (t = 0; t < CAL_TYPE_COUNT; t++) {
+    const uint32_t off = PROPS_CAL_OFFSET + (uint32_t)t * type_size;
+    if (t == patch_type) {
+      if (flash_program_noerase(dst + off, patch, type_size) < 0)
+        return -1;
+    } else {
+      if (flash_program_noerase(dst + off, (const void *)(src + off), type_size) < 0)
+        return -1;
+    }
+  }
+
+  // Checksum covers the header and the arrays, read back from flash.
+  uint32_t sum = checksum((const void *)dst, PROPS_RECORD_SIZE - sizeof(uint32_t));
+  if (flash_program_noerase(dst + PROPS_CHECKSUM_OFFSET, &sum, sizeof(sum)) < 0)
+    return -1;
+
+  return 0;
+}
+
+// Validate a slot's magic and checksum. Results are cached per slot.
+static bool cal_record_valid(int slot)
+{
+  const properties_t *src = cal_slot_hdr(slot);
+  if (checksum_ok & (1 << slot))
+    return true;
+  if (src->magic != PROPERTIES_MAGIC ||
+      checksum(src, PROPS_RECORD_SIZE - sizeof(uint32_t)) != src->checksum)
+    return false;
+  checksum_ok |= 1 << slot;
+  return true;
+}
