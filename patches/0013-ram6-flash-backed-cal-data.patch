+/*
+ * RAM-6: calibration storage.
+ *
+ * `_cal_data` (5 x 101 x 2 floats = 4,040 B) no longer lives in the RAM copy of
+ * `properties_t`; it lives in the calibration record on flash and is read
+ * through the `cal_data` pointer. The flash record keeps the exact byte layout
+ * of the upstream struct, so records remain interchangeable with the official
+ * firmware and with SD `.cal` files.
+ *
+ * Slots 0..CAL_USER_SLOTS-1 are user-visible. The two highest slots are a
+ * ping-pong pair: one holds the live working record, the other is the erase
+ * target for the next write. Calibration edits are built into the free slot
+ * while the working slot is still readable, then the roles swap. This is what
+ * avoids needing a 4 KB RAM staging buffer: flash cannot be modified in place
+ * (erase granularity is 2,048 B and the cal arrays are not page-aligned).
+ */
+#define CAL_USER_SLOTS      3
+#define CAL_SLOT_WORK       3
+#define CAL_SLOT_SCRATCH    4
+
+// Type of one calibration array (SWEEP_POINTS_MAX points of 2 floats).
+typedef const float (*cal_points_t)[2];
+
+// Point-wise transform callback: fill `out` with the five error terms for one
+// sweep point, reading that point from `src[type][0..1]`.
+typedef void (*cal_point_cb)(int point,
+                             float out[CAL_TYPE_COUNT][2],
+                             const float *src);
+
+// CAL_SLOT_POINTS_ADDR() is defined in nanovna.h.
+
+// The live calibration array. Statically initialised to the working slot so it
+// is valid from the first instruction, before any init function runs.
+float (*cal_data)[SWEEP_POINTS_MAX][2] =
+    (float (*)[SWEEP_POINTS_MAX][2])CAL_SLOT_POINTS_ADDR(CAL_SLOT_WORK);
+
+static int cal_active_slot = CAL_SLOT_WORK;
+static int cal_free_slot   = CAL_SLOT_SCRATCH;
+
+static inline properties_t *cal_slot_hdr(int slot) {
+  return (properties_t *)calibration_slot_area(slot);
+}
+
+static inline cal_points_t cal_slot_points(int slot, int type) {
+  return (cal_points_t)(calibration_slot_area(slot) + PROPS_CAL_OFFSET +
+                        (uint32_t)type * (uint32_t)(PROPS_CAL_SIZE / CAL_TYPE_COUNT));
+}
+
+static inline void cal_use_slot(int slot) {
+  cal_active_slot = slot;
+  cal_data = (float (*)[SWEEP_POINTS_MAX][2])cal_slot_points(slot, 0);
+}
