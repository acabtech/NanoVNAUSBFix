+// RAM-6: program a half-word into already-erased flash, without erasing first.
+// Returns 0 on success, -1 if the destination is not blank (a stale page would
+// otherwise silently corrupt the calibration record).
+int flash_program_half_word_noerase(uint16_t *dst, uint16_t value)
+{
+  flash_unlock();
+  if (*dst != 0xFFFF)
+    return -1;
+  __IO uint16_t *p = dst;
+  flash_wait_for_last_operation();
+  FLASH->CR |= FLASH_CR_PG;
+  *p = value;
+  flash_wait_for_last_operation();
+  FLASH->CR &= ~FLASH_CR_PG;
+  return 0;
+}
