# NanoVNA-USBFix — M2 binary measurement data transfer
# Authors: acabtech and @brrrassica
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Applies on top of 0004-scpi-foundation-sweep-parity.patch with patch -p1.
#
# Adds IEEE-488.2 definite-length block reads of the measured sweep, a
# waveform-style preamble query and the project release identity in *IDN?.
# The unofficial flavor switches to -Os because the 96 KiB code region has no
# room for new code at -O2.

--- a/main.c
+++ b/main.c
@@ -3375,6 +3375,68 @@
 }
 
 /*
+ * M2 binary data transfer.
+ *
+ * The payload is an IEEE-488.2 definite-length block: '#', one digit holding
+ * the number of decimal length digits, the decimal payload length, then the
+ * points. Every point is 12 bytes, little-endian (the Cortex-M0 is
+ * little-endian only):
+ *
+ *   offset 0  uint32  frequency in Hz
+ *   offset 4  float32 real part (raw, calibration-applied)
+ *   offset 8  float32 imaginary part
+ *
+ * 101 points cost 1,212 bytes, well below the 4,084-byte response window.
+ */
+#define VNA_DATA_POINT_BYTES 12
+#define VNA_DATA_BLOCK_MAX_HEADER 8
+
+int vna_usb_data_block(char *resp, int max, int sel, int start, int count) {
+  if (sel < 0 || sel > 1) sel = 0;
+  if (start < 0) start = 0;
+  if (start >= sweep_points) return 0;
+  if (count < 0 || start + count > sweep_points) count = sweep_points - start;
+
+  int max_points = (max - VNA_DATA_BLOCK_MAX_HEADER) / VNA_DATA_POINT_BYTES;
+  if (max_points <= 0) return 0;
+  if (count > max_points) count = max_points;
+
+  int payload = count * VNA_DATA_POINT_BYTES;
+  int digits = 1;
+  for (int v = payload; v >= 10; v /= 10) digits++;
+  int header = 2 + digits;
+
+  uint8_t *out = (uint8_t *)resp;
+  out[0] = '#';
+  out[1] = (uint8_t)('0' + digits);
+  int v = payload;
+  for (int i = digits - 1; i >= 0; i--) {
+    out[2 + i] = (uint8_t)('0' + (v % 10));
+    v /= 10;
+  }
+
+  uint8_t *dst = out + header;
+  for (int i = start; i < start + count; i++) {
+    uint32_t freq = (uint32_t)getFrequency(i);
+    float re = measured[sel][i][0];
+    float im = measured[sel][i][1];
+    memcpy(dst, &freq, sizeof(freq)); dst += sizeof(freq);
+    memcpy(dst, &re, sizeof(re));     dst += sizeof(re);
+    memcpy(dst, &im, sizeof(im));     dst += sizeof(im);
+  }
+  return header + payload;
+}
+
+/* Waveform-style preamble: points,start_hz,step_hz,format,bytes_per_point. */
+static int usb_format_data_preamble(char *resp, int max) {
+  return plot_printf(resp, max, "%u,%u,%u,RI32,%u" VNA_SHELL_NEWLINE_STR,
+                     (unsigned)sweep_points,
+                     (unsigned)getFrequency(0),
+                     (unsigned)getFrequencyStep(),
+                     (unsigned)VNA_DATA_POINT_BYTES);
+}
+
+/*
  * Minimal SCPI error queue. The queue is packed into two reserved property
  * words so it adds no BSS: eight 4-bit codes, oldest at the head.
  */
@@ -3481,6 +3543,10 @@
   return true;
 }
 
