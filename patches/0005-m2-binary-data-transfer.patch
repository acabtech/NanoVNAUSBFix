+  if (usb_ci_prefix(p, ":VNA:DATA:CHUNK?")) {
+    char *arg = usb_skip_space(p + 16);
+    int sel = my_atoui(arg);
+    char *comma = strchr(arg, ',');
+    int start = comma ? my_atoui(comma + 1) : 0;
+    char *fmt = NULL;
+    int count = 32;
+    if (comma) {
+      comma = strchr(comma + 1, ',');
+      if (comma) {
+        count = my_atoui(comma + 1);
+        comma = strchr(comma + 1, ',');
+        if (comma) fmt = usb_skip_space(comma + 1);
+      }
+    }
+    if (fmt && (usb_ci_prefix(fmt, "BIN") || usb_ci_prefix(fmt, "BLOCK")))
+      return vna_usb_data_block(resp, max, sel, start, count);
     return usb_format_data(resp, max, sel, start, count);
   }
