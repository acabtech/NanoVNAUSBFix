diff --git a/usbtmc.c b/usbtmc.c
new file mode 100644
index 0000000..350ab9b
--- /dev/null
+++ b/usbtmc.c
@@ -0,0 +1,308 @@
+/*
+ * NanoVNA-USBFix — USBTMC / SCPI bridge.
+ *
+ * Copyright (C) 2026 acabtech
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * The USB interrupt path only frames bulk messages and queues one command.
+ * Command execution and response formatting happen in the sweep thread via
+ * usbtmc_process(), so VNA internals are never touched from an ISR.
+ */
+
+#include "hal.h"
+#include "usbtmc.h"
+#include "usbcfg.h"
+#include "nanovna.h"
+
+#include <string.h>
+
+#define USBTMC_MAX_CMD      56
+#define USBTMC_EP_SIZE      64
+
+/* The response buffer borrows the LCD scratch buffer. Drawing is paused while
+   a response is pending (see usbtmc_response_pending), so the two never
+   overlap. */
+#define USBTMC_RESP_BUF     ((uint8_t *)spi_buffer)
+#define USBTMC_MAX_RESP     (SPI_BUFFER_SIZE * LCD_PIXEL_SIZE - 12)
+
+#define USBTMC_MSG_OUT      1
+#define USBTMC_MSG_IN       2
+#define USBTMC_EOM          0x01
+
+static USBInEndpointState  usbtmc_in_state;
+static USBOutEndpointState usbtmc_out_state;
+static USBInEndpointState  usbtmc_intr_state;
+
+static const USBEndpointConfig usbtmc_bulk_config = {
+  USB_EP_MODE_TYPE_BULK,
+  NULL,
+  usbtmc_data_transmitted,
+  usbtmc_data_received,
+  USBTMC_EP_SIZE,
+  USBTMC_EP_SIZE,
+  &usbtmc_in_state,
+  &usbtmc_out_state
+};
+
+static const USBEndpointConfig usbtmc_intr_config = {
+  USB_EP_MODE_TYPE_INTR,
+  NULL,
+  NULL,
+  NULL,
+  0x0008,
+  0x0000,
+  &usbtmc_intr_state,
+  NULL
+};
+
+static uint8_t  usbtmc_out_buf[USBTMC_EP_SIZE];
+static uint8_t  usbtmc_cmd_buf[USBTMC_MAX_CMD];
+
+static volatile uint32_t usbtmc_cmd_len;
+static volatile bool     usbtmc_cmd_ready;
+
+static volatile uint32_t usbtmc_resp_len;
+static volatile uint32_t usbtmc_resp_offset;
+static volatile bool     usbtmc_resp_ready;
+static volatile bool     usbtmc_tx_busy;
+static volatile bool     usbtmc_in_pending;
+static volatile uint8_t  usbtmc_in_tag;
+static volatile uint32_t usbtmc_in_length;
+
+/* Incoming message parser state. */
+static uint32_t usbtmc_msg_remaining;
+static bool     usbtmc_msg_eom;
+static bool     usbtmc_msg_bad;
+
+static void usbtmc_arm_out(USBDriver *usbp) {
+  usbStartReceiveI(usbp, USBTMC_BULK_OUT_EP, usbtmc_out_buf, sizeof(usbtmc_out_buf));
+}
+
+void usbtmc_reset(void) {
+  usbtmc_cmd_len = 0;
+  usbtmc_cmd_ready = false;
+  usbtmc_resp_len = 0;
+  usbtmc_resp_offset = 0;
+  usbtmc_resp_ready = false;
+  usbtmc_tx_busy = false;
+  usbtmc_in_pending = false;
+  usbtmc_msg_remaining = 0;
+  usbtmc_msg_eom = false;
+  usbtmc_msg_bad = false;
+}
+
+void usbtmc_configure(USBDriver *usbp) {
+  usbtmc_reset();
+  usbInitEndpointI(usbp, USBTMC_BULK_IN_EP, &usbtmc_bulk_config);
+  usbInitEndpointI(usbp, USBTMC_INTR_IN_EP, &usbtmc_intr_config);
+  usbtmc_arm_out(usbp);
+}
+
+/* Queue a response and start it if the host is already waiting. */
+static void usbtmc_start_response(USBDriver *usbp, uint32_t requested) {
+  if (!usbtmc_resp_ready || usbtmc_tx_busy) {
+    return;
+  }
+  if (usbtmc_resp_offset > usbtmc_resp_len) {
+    usbtmc_resp_offset = usbtmc_resp_len;
+  }
+  uint32_t remaining = usbtmc_resp_len - usbtmc_resp_offset;
+  uint32_t chunk = remaining;
+  if (chunk > requested) {
+    chunk = requested;
+  }
+  /* Move this window to the front of the payload area so the header and the
+     chunk are contiguous for usbStartTransmitI(). */
+  uint8_t *payload = USBTMC_RESP_BUF + 12;
+  memmove(payload, payload + usbtmc_resp_offset, chunk);
+  uint8_t *h = USBTMC_RESP_BUF;
+  h[0] = USBTMC_MSG_IN;
+  h[1] = usbtmc_in_tag;
+  h[2] = (uint8_t)~usbtmc_in_tag;
+  h[3] = 0;
+  h[4] = (uint8_t)(chunk & 0xFF);
+  h[5] = (uint8_t)((chunk >> 8) & 0xFF);
+  h[6] = (uint8_t)((chunk >> 16) & 0xFF);
+  h[7] = (uint8_t)((chunk >> 24) & 0xFF);
+  h[8] = (chunk == remaining) ? USBTMC_EOM : 0;
+  h[9] = 0;
+  h[10] = 0;
+  h[11] = 0;
+  usbtmc_resp_offset += chunk;
+  if (usbtmc_resp_offset >= usbtmc_resp_len) {
+    usbtmc_resp_ready = false;
+  }
+  usbtmc_tx_busy = true;
+  usbtmc_in_pending = false;
+  usbStartTransmitI(usbp, USBTMC_BULK_IN_EP, USBTMC_RESP_BUF, 12 + chunk);
+}
+
+void usbtmc_data_received(USBDriver *usbp, usbep_t ep) {
+  (void)ep;
+  size_t n = usbGetReceiveTransactionSizeX(usbp, USBTMC_BULK_OUT_EP);
+  const uint8_t *p = usbtmc_out_buf;
+  size_t left = n;
+
+  while (left > 0) {
+    if (usbtmc_msg_remaining == 0 && !usbtmc_msg_eom) {
+      /* Looking for a 12-byte USBTMC bulk-out header. */
+      if (left < 12) {
+        /* Short header: keep it simple and drop the malformed message. */
+        usbtmc_msg_bad = true;
+        left = 0;
+        break;
+      }
+      if (p[0] == USBTMC_MSG_IN) {
+        /* REQUEST_DEV_DEP_MSG_IN: the host wants the next response chunk. */
+        usbtmc_in_tag = p[1];
+        usbtmc_in_length = (uint32_t)p[4] |
+                           ((uint32_t)p[5] << 8) |
+                           ((uint32_t)p[6] << 16) |
+                           ((uint32_t)p[7] << 24);
+        usbtmc_in_pending = true;
+        if (usbtmc_resp_ready && !usbtmc_tx_busy) {
+          usbtmc_start_response(usbp, usbtmc_in_length);
+        }
+        p += 12;
+        left -= 12;
+        continue;
+      }
+      if (p[0] != USBTMC_MSG_OUT) {
+        usbtmc_msg_bad = true;
+        left = 0;
+        break;
+      }
+      usbtmc_cmd_len = 0;
+      usbtmc_msg_remaining = (uint32_t)p[4] |
+                             ((uint32_t)p[5] << 8) |
+                             ((uint32_t)p[6] << 16) |
+                             ((uint32_t)p[7] << 24);
+      usbtmc_msg_eom = (p[8] & USBTMC_EOM) != 0;
+      if (usbtmc_msg_remaining == 0) {
+        /* Zero-length write: dispatch immediately. */
+        if (!usbtmc_msg_bad) {
+          usbtmc_cmd_len = 0;
+          usbtmc_cmd_ready = true;
+        }
+        usbtmc_msg_eom = false;
+        usbtmc_msg_bad = false;
+      }
+      p += 12;
+      left -= 12;
+      continue;
+    }
+
+    size_t take = left;
+    if (take > usbtmc_msg_remaining) {
+      take = usbtmc_msg_remaining;
+    }
+    if (!usbtmc_msg_bad) {
+      for (size_t i = 0; i < take; i++) {
+        if (usbtmc_cmd_len < USBTMC_MAX_CMD - 1) {
+          usbtmc_cmd_buf[usbtmc_cmd_len++] = p[i];
+        } else {
+          usbtmc_msg_bad = true;
+        }
+      }
+    }
+    p += take;
+    left -= take;
+    usbtmc_msg_remaining -= take;
+
+    if (usbtmc_msg_remaining == 0) {
+      if (usbtmc_msg_eom) {
+        if (!usbtmc_msg_bad) {
+          usbtmc_cmd_ready = true;
+        }
+        usbtmc_msg_eom = false;
+        usbtmc_msg_bad = false;
+      }
+      /* Non-EOM chunks continue in the next bulk packet. */
+    }
+  }
+
+  usbtmc_arm_out(usbp);
+}
+
+void usbtmc_data_transmitted(USBDriver *usbp, usbep_t ep) {
+  (void)usbp;
+  (void)ep;
+  usbtmc_tx_busy = false;
+}
+
+bool usbtmc_requests_hook(USBDriver *usbp) {
+  uint8_t type = usbp->setup.bmRequestType;
+  if ((type & USB_RTYPE_TYPE_MASK) != USB_RTYPE_TYPE_CLASS ||
+      (type & USB_RTYPE_RECIPIENT_MASK) != USB_RTYPE_RECIPIENT_INTERFACE ||
+      usbp->setup.wIndex != USBTMC_INTERFACE_NUMBER) {
+    return false;
+  }
+
+  switch (usbp->setup.bRequest) {
+  case 128: { /* READ_STATUS_BYTE */
+    static uint8_t status[2] = {0, 0};
+    usbSetupTransfer(usbp, status, sizeof(status), NULL);
+    return true;
+  }
+  case 5: { /* INITIATE_CLEAR */
+    static uint8_t clear_status = 0;
+    usbSetupTransfer(usbp, &clear_status, sizeof(clear_status), NULL);
+    return true;
+  }
+  case 6:   /* CHECK_CLEAR_STATUS */
+  case 1:   /* INITIATE_ABORT_BULK_OUT */
+  case 2:   /* CHECK_ABORT_BULK_OUT_STATUS */
+  case 3:   /* INITIATE_ABORT_BULK_IN */
+  case 4: { /* CHECK_ABORT_BULK_IN_STATUS */
+    static uint8_t status[2] = {0, 0};
+    usbSetupTransfer(usbp, status, sizeof(status), NULL);
+    return true;
+  }
+  case 7: { /* GET_CAPABILITIES */
+    static uint8_t caps[3] = {0, 0, 0};
+    usbSetupTransfer(usbp, caps, sizeof(caps), NULL);
+    return true;
+  }
+  default:
+    return false;
+  }
+}
+
+bool usbtmc_response_pending(void) {
+  return usbtmc_resp_ready || usbtmc_tx_busy;
+}
+
+void usbtmc_process(void) {
+  if (usbtmc_cmd_ready) {
+    usbtmc_cmd_ready = false;
+    usbtmc_cmd_buf[usbtmc_cmd_len] = 0;
+
+    int n = vna_usb_scpi_exec((char *)usbtmc_cmd_buf,
+                              (char *)(USBTMC_RESP_BUF + 12),
+                              USBTMC_MAX_RESP);
+    usbtmc_cmd_len = 0;
+    if (n < 0) {
+      n = 0;
+    }
+    usbtmc_resp_len = (uint32_t)n;
+    usbtmc_resp_offset = 0;
+    /* A set-only command (no data) must not leave the display paused. */
+    usbtmc_resp_ready = (n > 0);
+  }
+
+  if (usbtmc_in_pending) {
+    if (!usbtmc_resp_ready && !usbtmc_tx_busy) {
+      /* Query with an empty response: answer with a zero-length message. */
+      usbtmc_resp_len = 0;
+      usbtmc_resp_offset = 0;
+      usbtmc_resp_ready = true;
+    }
+    if (usbtmc_resp_ready && !usbtmc_tx_busy) {
+      osalSysLock();
+      usbtmc_start_response(&USBD1, usbtmc_in_length);
+      osalSysUnlock();
+    }
+  }
+}
+
+/* USBTMC requests are handled by the interface request hook in usbcfg.c. */
