+
+/*
+ * Memory-backed shell stream used to capture command output for USBTMC.
+ */
+typedef struct {
+  BaseSequentialStream stream;
+  char *buf;
+  int size;
+  int len;
+} UsbMemStream;
+
+static size_t usb_mem_write(void *ip, const uint8_t *bp, size_t n) {
+  UsbMemStream *s = (UsbMemStream *)ip;
+  if (s->buf != NULL) {
+    int space = s->size - s->len;
+    int copy = (int)n;
+    if (copy > space) copy = space;
+    if (copy > 0) {
+      memcpy(s->buf + s->len, bp, copy);
+      s->len += copy;
+    }
+  }
+  return n;
+}
+static size_t usb_mem_read(void *ip, uint8_t *bp, size_t n) {
+  (void)ip; (void)bp; (void)n;
+  return 0;
+}
+static msg_t usb_mem_put(void *ip, uint8_t b) {
+  (void)ip; (void)b;
+  return MSG_OK;
+}
+static msg_t usb_mem_get(void *ip) {
+  (void)ip;
+  return MSG_RESET;
+}
+static const struct BaseSequentialStreamVMT usb_mem_vmt = {
+  usb_mem_write, usb_mem_read, usb_mem_put, usb_mem_get
+};
+
+/* Execute one VNA shell command and capture its output (or discard it). */
+static int usb_run_shell(char *line, char *out, int max) {
+  UsbMemStream ms;
+  char *args[VNA_SHELL_MAX_ARGUMENTS + 1];
+  BaseSequentialStream *saved;
+  int n;
+
+  ms.stream.vmt = &usb_mem_vmt;
+  ms.buf = out;
+  ms.size = max;
+  ms.len = 0;
+
+  n = parse_line(line, args, ARRAY_COUNT(args));
+  if (n > (int)ARRAY_COUNT(args))
+    n = ARRAY_COUNT(args);
+
+  chMtxLock(&shell_io_mutex);
+  saved = shell_stream;
+  shell_stream = (BaseSequentialStream *)&ms;
+  if (n > 0) {
+    const VNAShellCommand *scp;
+    for (scp = commands; scp->sc_name != NULL; scp++)
+      if (get_str_index(scp->sc_name, args[0]) == 0)
+        break;
+    if (scp->sc_name != NULL)
+      scp->sc_function(n - 1, &args[1]);
+    else
+      shell_printf("%s?" VNA_SHELL_NEWLINE_STR, args[0]);
+  }
+  shell_stream = saved;
+  chMtxUnlock(&shell_io_mutex);
+
+  if (out != NULL && ms.len < max)
+    out[ms.len] = 0;
+  return ms.len;
+}
+
+static bool usb_ci_prefix(const char *s, const char *prefix) {
+  while (*prefix) {
+    char a = *s++, b = *prefix++;
+    if (a >= 'a' && a <= 'z') a -= 32;
+    if (b >= 'a' && b <= 'z') b -= 32;
+    if (a != b) return false;
+  }
+  return true;
+}
+
+static char *usb_skip_space(char *p) {
+  while (*p == ' ' || *p == '\t') p++;
+  return p;
+}
+
+static int usb_format_data(char *resp, int max, int sel, int start, int count) {
+  int n = 0;
+  if (sel < 0 || sel > 1) sel = 0;
+  if (start < 0) start = 0;
+  if (start >= sweep_points) return 0;
+  if (count < 0 || start + count > sweep_points) count = sweep_points - start;
+  for (int i = start; i < start + count; i++) {
+    int room = max - n;
+    if (room <= 0) break;
+    int w = plot_printf(resp + n, room, "%u,%f,%f" VNA_SHELL_NEWLINE_STR,
+                       getFrequency(i), measured[sel][i][0], measured[sel][i][1]);
+    if (w <= 0) break;
+    n += w;
+  }
+  if (n >= max) n = max - 1;
+  resp[n] = 0;
+  return n;
+}
+
+/*
+ * The SCPI-style command surface implemented by the unofficial firmware.
+ * Anything not covered here is still reachable through :VNA:CMD / :VNA:CMD?.
+ */
+int vna_usb_scpi_exec(char *line, char *resp, int max) {
+  char *p = line;
+  char *end;
+  char cmd[VNA_SHELL_MAX_LENGTH];
+
+  if (max <= 0) return 0;
+  resp[0] = 0;
+
+  while (*p == ' ' || *p == '\t') p++;
+  end = p + strlen(p);
+  while (end > p && (end[-1] == '\r' || end[-1] == '\n' ||
+                     end[-1] == ' ' || end[-1] == '\t')) *--end = 0;
+  if (*p == 0) return 0;
+
+  if (usb_ci_prefix(p, "*IDN?"))
+    return plot_printf(resp, max, "NanoVNA-H,USBFix," VERSION ",00000000" VNA_SHELL_NEWLINE_STR);
+  if (usb_ci_prefix(p, "*OPC?"))
+    return plot_printf(resp, max, "1" VNA_SHELL_NEWLINE_STR);
+  if (usb_ci_prefix(p, "*CLS"))
+    return 0;
+  if (usb_ci_prefix(p, "*RST"))
+    return 0;
+  if (usb_ci_prefix(p, ":SYST:ERR?"))
+    return plot_printf(resp, max, "0,\"No error\"" VNA_SHELL_NEWLINE_STR);
+
+  /* Generic escape hatch: run any NanoVNA shell command. */
+  if (usb_ci_prefix(p, ":VNA:CMD?")) {
+    char *arg = usb_skip_space(p + 9);
+    if (*arg == 0)
+      return plot_printf(resp, max, "-109,\"Missing parameter\"" VNA_SHELL_NEWLINE_STR);
+    strncpy(cmd, arg, sizeof(cmd) - 1);
+    cmd[sizeof(cmd) - 1] = 0;
+    return usb_run_shell(cmd, resp, max);
+  }
+  if (usb_ci_prefix(p, ":VNA:CMD")) {
+    char *arg = usb_skip_space(p + 8);
+    if (*arg == 0)
+      return plot_printf(resp, max, "-109,\"Missing parameter\"" VNA_SHELL_NEWLINE_STR);
+    strncpy(cmd, arg, sizeof(cmd) - 1);
+    cmd[sizeof(cmd) - 1] = 0;
+    usb_run_shell(cmd, NULL, 0);
+    return 0;
+  }
+
+  /* Structured convenience commands. */
+  if (usb_ci_prefix(p, ":VNA:SWE:START?"))
+    return plot_printf(resp, max, "%u" VNA_SHELL_NEWLINE_STR, get_sweep_frequency(ST_START));
+  if (usb_ci_prefix(p, ":VNA:SWE:STOP?"))
+    return plot_printf(resp, max, "%u" VNA_SHELL_NEWLINE_STR, get_sweep_frequency(ST_STOP));
+  if (usb_ci_prefix(p, ":VNA:SWE:POINTS?"))
+    return plot_printf(resp, max, "%u" VNA_SHELL_NEWLINE_STR, sweep_points);
+  if (usb_ci_prefix(p, ":VNA:SWE:START")) {
+    plot_printf(cmd, sizeof(cmd), "sweep start %u", my_atoui(usb_skip_space(p + 14)));
+    usb_run_shell(cmd, NULL, 0);
+    return 0;
+  }
+  if (usb_ci_prefix(p, ":VNA:SWE:STOP")) {
+    plot_printf(cmd, sizeof(cmd), "sweep stop %u", my_atoui(usb_skip_space(p + 13)));
+    usb_run_shell(cmd, NULL, 0);
+    return 0;
+  }
+  if (usb_ci_prefix(p, ":VNA:SWE:POINTS")) {
+    plot_printf(cmd, sizeof(cmd), "sweep 0 0 %u", my_atoui(usb_skip_space(p + 15)));
+    usb_run_shell(cmd, NULL, 0);
+    return 0;
+  }
+  if (usb_ci_prefix(p, ":VNA:SWE:EXEC")) {
+    plot_printf(cmd, sizeof(cmd), "scan %u %u %u 0",
+               get_sweep_frequency(ST_START), get_sweep_frequency(ST_STOP), sweep_points);
+    usb_run_shell(cmd, NULL, 0);
+    return 0;
+  }
+  if (usb_ci_prefix(p, ":VNA:FREQ?"))
+    return plot_printf(resp, max, "%u" VNA_SHELL_NEWLINE_STR, get_sweep_frequency(ST_CW));
+  if (usb_ci_prefix(p, ":VNA:FREQ")) {
+    plot_printf(cmd, sizeof(cmd), "freq %u", my_atoui(usb_skip_space(p + 9)));
+    usb_run_shell(cmd, NULL, 0);
+    return 0;
+  }
+  if (usb_ci_prefix(p, ":VNA:PAUSE")) {
+    usb_run_shell("pause", NULL, 0);
+    return 0;
+  }
+  if (usb_ci_prefix(p, ":VNA:RESUME")) {
+    usb_run_shell("resume", NULL, 0);
+    return 0;
+  }
+
+  if (usb_ci_prefix(p, ":VNA:DATA:CHUNK?")) {
+    char *arg = usb_skip_space(p + 16);
+    int sel = my_atoui(arg);
+    char *comma = strchr(arg, ',');
+    int start = comma ? my_atoui(comma + 1) : 0;
+    comma = comma ? strchr(comma + 1, ',') : NULL;
+    int count = comma ? my_atoui(comma + 1) : 32;
+    return usb_format_data(resp, max, sel, start, count);
+  }
+  if (usb_ci_prefix(p, ":VNA:DATA?")) {
+    char *arg = usb_skip_space(p + 10);
+    int sel = *arg ? my_atoui(arg) : 0;
+    return usb_format_data(resp, max, sel, 0, SWEEP_POINTS_MAX);
+  }
+
+  return plot_printf(resp, max, "-113,\"Undefined header\"" VNA_SHELL_NEWLINE_STR);
+}
