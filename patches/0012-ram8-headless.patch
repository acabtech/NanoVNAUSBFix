+//**************************************************************************************
+//            RAM-8: headless mode
+//**************************************************************************************
+// Runtime-only: this is deliberately not stored in config, so a power cycle is
+// the guaranteed way back to a normal display even if USB/shell is unavailable.
+#define HEADLESS_ON     0x01
+#define HEADLESS_NOTICE 0x02
+static uint8_t headless_state;
+
+bool plot_headless_mode(void) {
+  return (headless_state & HEADLESS_ON) != 0;
+}
+
+// Return the render cache memory as a scratch arena while headless. Callers
+// must stop using it before calling plot_set_headless(false). Returns NULL and
+// size 0 in normal display mode.
+void *plot_headless_scratch(uint32_t *size) {
+  if (!plot_headless_mode()) {
+    if (size) *size = 0;
+    return NULL;
+  }
+  if (size) *size = sizeof(plot_mem.scratch);
+  return plot_mem.scratch;
+}
+
+static void plot_draw_headless_notice(void) {
+  lcd_set_colors(LCD_FG_COLOR, LCD_BG_COLOR);
+  lcd_clear_screen();
+  // Title at 2x; the body uses the small font (8 px versus 11 px normal),
+  // which is the closest available step to two-thirds of the title height.
+  lcd_drawstring_size("HEADLESS MODE", 8, 8, 2);
+  lcd_set_font(FONT_SMALL);
+  lcd_drawstring(8,  48, "Display disabled.");
+  lcd_drawstring(8,  62, "Data is on USB.");
+  lcd_drawstring(8,  80, "Green LED blinks while alive.");
+  lcd_drawstring(8,  94, "Power cycle to restore display.");
+  lcd_set_font(FONT_NORMAL);
+}
+
+void plot_set_headless(bool on) {
+  if (on == plot_headless_mode()) return;
+  if (on) {
+    headless_state = HEADLESS_ON | HEADLESS_NOTICE;
+    // The stored-trace cache is display-only and lives in the union now.
+#if STORED_TRACES > 0
+    enabled_store_trace = 0;
+    for (int i = 0; i < TRACE_INDEX_COUNT - TRACES_MAX; i++)
+      stored_traces_points[i] = 0;
+#endif
+    redraw_request = 0;
+  } else {
+    headless_state = 0;
+    request_to_redraw(REDRAW_PLOT | REDRAW_ALL);
+  }
+}
+
+// Called from the sweep thread only when a USBTMC response is not pending, so
+// it may borrow spi_buffer for the one-time notice screen.
+void plot_headless_service(void) {
+  if (!plot_headless_mode()) return;
+  // 1 Hz square wave derived from the system tick; no extra timer state.
+  if ((chVTGetSystemTimeX() / MS2ST(500)) & 1)
+    palSetPad(GPIOC, GPIOC_LED);
+  else
+    palClearPad(GPIOC, GPIOC_LED);
+  if (headless_state & HEADLESS_NOTICE) {
+    headless_state&= ~HEADLESS_NOTICE;
+    plot_draw_headless_notice();
+  }
+}
+
