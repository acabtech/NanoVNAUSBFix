+// RAM-8: runtime-only headless mode. Not stored in config, so a power cycle is
+// the guaranteed way back to the normal display.
+VNA_SHELL_FUNCTION(cmd_headless)
+{
+  if (argc == 0) {
+    if (plot_headless_mode()) {
+      uint32_t size;
+      plot_headless_scratch(&size);
+      shell_printf("headless: on, scratch %u bytes" VNA_SHELL_NEWLINE_STR,
+                   (unsigned)size);
+    } else {
+      shell_printf("headless: off" VNA_SHELL_NEWLINE_STR);
+    }
+    return;
+  }
+  int v = get_str_index(argv[0], "on|off");
+  if (v < 0) {
+    shell_printf("usage: headless {on|off}" VNA_SHELL_NEWLINE_STR);
+    return;
+  }
+  plot_set_headless(v == 0);
+  shell_printf("headless %s (power cycle to restore display)" VNA_SHELL_NEWLINE_STR,
+               v == 0 ? "on" : "off");
+}
