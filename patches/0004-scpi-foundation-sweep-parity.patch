+/*
+ * Host-facing SCPI state (averaging, telemetry and the error queue).
+ * Authors: acabtech and @brrrassica.
+ *
+ * The F072 has no spare BSS: the link fails if even a few bytes are added.
+ * properties_t._reserved1[] is unused by upstream, survives in RAM, and is
+ * explicitly zeroed after every property recall by vna_host_state_init().
+ *
+ * Layout:
+ *   [0] bits 0..15 averaging count, bit 16 averaging restart flag
+ *   [1] last completed sweep duration in milliseconds
+ *   [2] point count used by that sweep
+ *   [3] packed 4-bit error codes, oldest at slot head
+ *   [4] bits 0..7 error queue head, bits 8..15 error queue count
+ */
+#define VNA_HOST_STATE      current_props._reserved1
+#define VNA_HOST_AVG        VNA_HOST_STATE[0]
+#define VNA_HOST_SWEEP_MS   VNA_HOST_STATE[1]
+#define VNA_HOST_SWEEP_PTS  VNA_HOST_STATE[2]
+
+static void vna_host_state_init(void) {
+  memset(VNA_HOST_STATE, 0, sizeof(current_props._reserved1));
+  /* One averaging pass (disabled) and a restart flag for the first sweep. */
+  VNA_HOST_AVG = 1u | 0x10000u;
+}
+
+static inline uint16_t vna_avg_count(void) {
+  return (uint16_t)(VNA_HOST_AVG & 0xFFFFu);
+}
+static inline void vna_set_avg_count(uint16_t count) {
+  VNA_HOST_AVG = (VNA_HOST_AVG & 0xFFFF0000u) | count;
+}
+static inline bool vna_avg_restart(void) {
+  return (VNA_HOST_AVG & 0x10000u) != 0;
+}
+static inline void vna_set_avg_restart(bool restart) {
+  if (restart)
+    VNA_HOST_AVG |= 0x10000u;
+  else
+    VNA_HOST_AVG &= ~0x10000u;
+}
+
+static inline float vna_apply_average(float old_value, float new_value) {
+  uint16_t count = vna_avg_count();
+  if (count <= 1 || vna_avg_restart())
+    return new_value;
+  return old_value + (new_value - old_value) / (float)count;
+}
