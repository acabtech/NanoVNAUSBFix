 /*
+ * Minimal SCPI error queue. The queue is packed into two reserved property
+ * words so it adds no BSS: eight 4-bit codes, oldest at the head.
+ */
+#define SCPI_ERR_QUEUE_LEN 8
+
+static const char *scpi_error_text(int16_t code) {
+  switch (code) {
+    case -113: return "Undefined header";
+    case -109: return "Missing parameter";
+    case -222: return "Data out of range";
+    case -200: return "Execution error";
+    default:   return "Error";
+  }
+}
+
+static uint8_t scpi_error_code_to_nibble(int16_t code) {
+  switch (code) {
+    case -113: return 1;
+    case -109: return 2;
+    case -222: return 3;
+    case -200: return 4;
+    default:   return 4;
+  }
+}
+
+static int16_t scpi_error_nibble_to_code(uint8_t nibble) {
+  switch (nibble) {
+    case 1: return -113;
+    case 2: return -109;
+    case 3: return -222;
+    case 4: return -200;
+    default: return 0;
+  }
+}
+
+static uint8_t scpi_error_head(void) {
+  return (uint8_t)(VNA_HOST_STATE[4] & 0xFF);
+}
+static uint8_t scpi_error_count(void) {
+  return (uint8_t)((VNA_HOST_STATE[4] >> 8) & 0xFF);
+}
+static void scpi_error_set_index(uint8_t head, uint8_t count) {
+  VNA_HOST_STATE[4] = (uint32_t)head | ((uint32_t)count << 8);
+}
+
+static void scpi_error_push(int16_t code) {
+  uint32_t packed = VNA_HOST_STATE[3];
+  uint8_t head = scpi_error_head();
+  uint8_t count = scpi_error_count();
+  if (count >= SCPI_ERR_QUEUE_LEN) {
+    /* Drop the oldest entry so the newest failure is always visible. */
+    head = (head + 1) % SCPI_ERR_QUEUE_LEN;
+    count--;
+  }
+  uint8_t slot = (head + count) % SCPI_ERR_QUEUE_LEN;
+  uint32_t shift = (uint32_t)slot * 4U;
+  packed = (packed & ~(0xFu << shift)) |
+           ((uint32_t)scpi_error_code_to_nibble(code) << shift);
+  VNA_HOST_STATE[3] = packed;
+  scpi_error_set_index(head, count + 1);
+}
+
+static int16_t scpi_error_pop(void) {
+  uint8_t head = scpi_error_head();
+  uint8_t count = scpi_error_count();
+  if (count == 0)
+    return 0;
+  uint8_t nibble = (uint8_t)((VNA_HOST_STATE[3] >> ((uint32_t)head * 4U)) & 0xFu);
+  scpi_error_set_index((head + 1) % SCPI_ERR_QUEUE_LEN, count - 1);
+  return scpi_error_nibble_to_code(nibble);
+}
+
+static void scpi_error_queue_clear(void) {
+  VNA_HOST_STATE[3] = 0;
+  VNA_HOST_STATE[4] = 0;
+}
+
+static int scpi_error_response(char *resp, int max, int16_t code) {
+  scpi_error_push(code);
+  return plot_printf(resp, max, "%d,\"%s\"" VNA_SHELL_NEWLINE_STR,
+                     code, scpi_error_text(code));
+}
+
+/* Return a deterministic serial derived from the 96-bit MCU unique ID. */
+static int usb_format_uid(char *resp, int max) {
+#ifdef UID_BASE
+  const uint32_t *uid = (const uint32_t *)UID_BASE;
+  return plot_printf(resp, max, "%08X%08X%08X",
+                     (unsigned int)uid[0], (unsigned int)uid[1],
+                     (unsigned int)uid[2]);
+#else
+  (void)resp;
+  (void)max;
+  return 0;
+#endif
+}
+
+static bool usb_parse_u32(char *p, uint32_t *value) {
+  p = usb_skip_space(p);
+  if (*p < '0' || *p > '9')
+    return false;
+  *value = my_atoui(p);
+  return true;
+}
